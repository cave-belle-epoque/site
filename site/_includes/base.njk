<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>La Belle Époque — Cave à vin & Bar Gourmand · Saint-Symphorien-sur-Coise</title>
<meta name="description" content="Cave à vin, bar gourmand et table du midi place du Marché à Saint-Symphorien-sur-Coise. Plus de 250 vins choisis un par un.">
<!-- TODO une fois le domaine définitif choisi : passer "image" en URL absolue ci-dessous -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WineBar",
  "name": "La Belle Époque",
  "image": "/assets/terrasse.jpg",
  "telephone": "+33426554671",
  "email": "cavelabelleepoque@outlook.fr",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "64 place du Marché",
    "postalCode": "69590",
    "addressLocality": "Saint-Symphorien-sur-Coise",
    "addressCountry": "FR"
  },
  "openingHoursSpecification": {{ openingHours | dump | safe }}
}
</script>
<style>
:root{
  --rose:#F3BFC3;
  --rose-deep:#B4515F;
  --rose-soft:#FBEEEF;
  --ink:#14100F;
  --ink-2:#4A4340;
  --ink-3:#8A807A;
  --paper:#FFFFFF;
  --cream:#FAF6F3;
  --stone:#EDE7E2;
  --line:#E4DCD6;
  --serif:"Iowan Old Style","Palatino Linotype",Palatino,"Book Antiqua",Georgia,serif;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,"Helvetica Neue",Arial,sans-serif;
  --wrap:1120px;
  --r:14px;
}
*{box-sizing:border-box}
html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
body{
  margin:0;background:var(--paper);color:var(--ink);
  font-family:var(--sans);font-size:16.5px;line-height:1.65;
  -webkit-font-smoothing:antialiased;
}
img{max-width:100%;display:block}
a{color:inherit}
.wrap{width:100%;max-width:var(--wrap);margin:0 auto;padding:0 20px}

/* ---------- typography ---------- */
h1,h2,h3{font-family:var(--serif);font-weight:400;letter-spacing:-.01em;margin:0}
h2{font-size:clamp(27px,5.4vw,40px);line-height:1.15}
h3{font-size:19px;line-height:1.3}
.eyebrow{
  font-family:var(--sans);font-size:11.5px;font-weight:700;
  letter-spacing:.19em;text-transform:uppercase;color:var(--rose-deep);
  margin:0 0 12px;display:flex;align-items:center;gap:9px;
}
.eyebrow::after{content:"";height:1px;flex:1;background:var(--line);max-width:70px}
.lead{color:var(--ink-2);font-size:17px;margin:14px 0 0;max-width:56ch}
.section{padding:64px 0}
.section--cream{background:var(--cream)}
.section-head{margin-bottom:32px}

/* ---------- header ---------- */
header{
  position:sticky;top:0;z-index:60;background:rgba(255,255,255,.94);
  backdrop-filter:saturate(180%) blur(14px);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--line);
}
.bar{display:flex;align-items:center;gap:16px;height:62px}
.brand{display:flex;align-items:center;flex:1;min-width:0}
.brand img{height:34px;width:auto;mix-blend-mode:multiply}
nav{display:none;gap:26px;font-size:14.5px}
nav a{text-decoration:none;color:var(--ink-2);white-space:nowrap}
nav a:hover{color:var(--rose-deep)}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:12px 20px;border-radius:100px;border:1px solid transparent;
  font-size:14.5px;font-weight:600;text-decoration:none;cursor:pointer;
  font-family:var(--sans);transition:.18s ease;white-space:nowrap;
}
.btn--ink{background:var(--ink);color:#fff}
.btn--ink:hover{background:var(--rose-deep)}
.btn--ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
.btn--ghost:hover{background:var(--ink);color:#fff}
.btn--light{background:#fff;color:var(--ink)}
.btn--light:hover{background:var(--rose)}
.btn--sm{padding:9px 17px;font-size:13.5px}

/* ---------- hero ---------- */
.hero{position:relative;min-height:78vh;display:flex;align-items:flex-end;overflow:hidden}
.hero__img{position:absolute;inset:0}
.hero__img img{width:100%;height:100%;object-fit:cover}
.hero__img::after{
  content:"";position:absolute;inset:0;
  background:linear-gradient(180deg,rgba(20,16,15,.30) 0%,rgba(20,16,15,.12) 32%,rgba(20,16,15,.78) 100%);
}
.hero__inner{position:relative;z-index:2;width:100%;padding-top:56px;padding-bottom:46px;color:#fff}
.hero h1{
  font-size:clamp(38px,10.5vw,74px);line-height:1.02;color:#fff;
  text-shadow:0 2px 26px rgba(0,0,0,.3);max-width:14ch;
}
.hero .kicker{
  font-size:12px;font-weight:700;letter-spacing:.22em;text-transform:uppercase;
  color:var(--rose);margin:0 0 16px;
}
.hero p.sub{color:rgba(255,255,255,.9);font-size:17px;margin:16px 0 0;max-width:40ch;text-shadow:0 1px 14px rgba(0,0,0,.35)}
.hero__cta{display:flex;flex-wrap:wrap;gap:11px;margin-top:28px}

/* ---------- status strip ---------- */
.strip{background:var(--ink);color:#fff}
.strip__in{display:flex;flex-wrap:wrap;align-items:center;gap:12px 26px;padding-top:15px;padding-bottom:15px;font-size:14.5px}
.dot{width:8px;height:8px;border-radius:50%;background:#5FD08A;display:inline-block;margin-right:9px;box-shadow:0 0 0 3px rgba(95,208,138,.22)}
.dot--off{background:var(--rose);box-shadow:0 0 0 3px rgba(243,191,195,.2)}
.strip b{font-weight:600}
.strip span{color:rgba(255,255,255,.62)}
.strip a{color:#fff;text-decoration:none;border-bottom:1px solid rgba(255,255,255,.32);padding-bottom:1px}
.strip .sep{display:none}

/* ---------- trio ---------- */
.trio{display:grid;gap:14px;position:relative;z-index:1}
.card{
  background:var(--paper);border:1px solid var(--line);border-radius:var(--r);
  padding:26px 24px 28px;transition:.2s ease;
}
.card:hover{border-color:var(--rose);transform:translateY(-2px)}
.card .num{
  font-family:var(--serif);font-size:13px;color:var(--rose-deep);
  letter-spacing:.14em;margin-bottom:14px;display:block;
}
.card p{color:var(--ink-2);font-size:15.5px;margin:10px 0 0}
.card .meta{
  margin-top:18px;padding-top:15px;border-top:1px solid var(--line);
  font-size:13.5px;color:var(--ink-3);
}

/* ---------- menu ---------- */
.menu-grid{display:grid;gap:22px}
.menu-card{
  background:var(--paper);border:1px solid var(--line);border-radius:var(--r);
  overflow:hidden;
}
.menu-card__top{
  padding:22px 24px;border-bottom:1px solid var(--line);
  display:flex;justify-content:space-between;align-items:baseline;gap:14px;flex-wrap:wrap;
  background:var(--rose-soft);
}
.menu-card__top h3{font-size:21px}
.price{font-family:var(--serif);font-size:22px;color:var(--rose-deep);white-space:nowrap}
.days{list-style:none;margin:0;padding:6px 0}
.days li{
  display:flex;gap:16px;padding:15px 24px;border-bottom:1px solid var(--stone);
  align-items:flex-start;
}
.days li:last-child{border-bottom:0}
.days .d{
  flex:0 0 88px;font-size:12px;font-weight:700;letter-spacing:.13em;
  text-transform:uppercase;color:var(--ink-3);padding-top:3px;
}
.days .plat{flex:1;font-size:15.5px}
.days .plat em{display:block;color:var(--ink-3);font-style:normal;font-size:13.5px;margin-top:3px}
.days li.hl{background:var(--rose-soft)}
.days li.hl .d{color:var(--rose-deep)}
.tag{
  display:inline-block;background:var(--rose-deep);color:#fff;font-size:10.5px;
  font-weight:700;letter-spacing:.11em;text-transform:uppercase;
  padding:3px 9px;border-radius:100px;margin-left:8px;vertical-align:2px;
}
.aside-card{
  background:var(--ink);color:#fff;border-radius:var(--r);padding:28px 26px;
}
.aside-card h3{color:#fff;font-size:20px}
.aside-card p{color:rgba(255,255,255,.72);font-size:15px;margin:12px 0 0}
.aside-card ul{margin:18px 0 0;padding:0;list-style:none;font-size:15px}
.aside-card li{padding:9px 0;border-bottom:1px solid rgba(255,255,255,.11);display:flex;justify-content:space-between;gap:14px}
.aside-card li:last-child{border-bottom:0}
.aside-card li span{color:var(--rose)}

/* ---------- events ---------- */
.events{display:grid;gap:14px}
.ev{
  display:flex;gap:20px;background:var(--paper);border:1px solid var(--line);
  border-radius:var(--r);padding:20px 22px;align-items:flex-start;transition:.2s ease;
}
.ev:hover{border-color:var(--rose)}
.ev__date{
  flex:0 0 62px;text-align:center;background:var(--rose-soft);
  border-radius:10px;padding:9px 4px;
}
.ev__date .dd{font-family:var(--serif);font-size:25px;line-height:1;color:var(--rose-deep)}
.ev__date .mm{font-size:10.5px;font-weight:700;letter-spacing:.13em;text-transform:uppercase;color:var(--rose-deep);margin-top:4px}
.ev__body{flex:1;min-width:0}
.ev__body .when{font-size:13px;color:var(--ink-3);margin-top:5px}
.ev__body p{font-size:15px;color:var(--ink-2);margin:9px 0 0}
.ev--next{border-color:var(--rose-deep);background:var(--rose-soft)}
.ev--next .ev__date{background:var(--rose-deep)}
.ev--next .ev__date .dd,.ev--next .ev__date .mm{color:#fff}

/* ---------- form ---------- */
.resa{display:grid;gap:26px}
.form-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:26px 22px}
.fgrid{display:grid;gap:15px}
.field label{
  display:block;font-size:12px;font-weight:700;letter-spacing:.1em;
  text-transform:uppercase;color:var(--ink-3);margin-bottom:7px;
}
.field input,.field select,.field textarea{
  width:100%;padding:13px 14px;border:1px solid var(--line);border-radius:10px;
  font-family:var(--sans);font-size:16px;color:var(--ink);background:#fff;
  transition:.16s ease;-webkit-appearance:none;appearance:none;
}
.field select{background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='12' height='8'><path d='M1 1l5 5 5-5' stroke='%238A807A' stroke-width='1.6' fill='none' stroke-linecap='round'/></svg>");background-repeat:no-repeat;background-position:right 14px center}
.field input:focus,.field select:focus,.field textarea:focus{
  outline:none;border-color:var(--rose-deep);box-shadow:0 0 0 3px rgba(180,81,95,.12);
}
.field textarea{min-height:84px;resize:vertical}
.note{font-size:13.5px;color:var(--ink-3);margin:16px 0 0;display:flex;gap:9px;align-items:flex-start}
.note svg{flex:0 0 15px;margin-top:3px}
.ok{
  display:none;background:var(--rose-soft);border:1px solid var(--rose);
  border-radius:10px;padding:16px 18px;font-size:15px;margin-bottom:18px;
}
.ok.show{display:block}

/* ---------- cave ---------- */
.cave{display:grid;gap:14px}
.stat{background:var(--paper);border:1px solid var(--line);border-radius:var(--r);padding:24px}
.stat .big{font-family:var(--serif);font-size:40px;line-height:1;color:var(--rose-deep)}
.stat p{margin:10px 0 0;font-size:15px;color:var(--ink-2)}

/* ---------- infos ---------- */
.infos{display:grid;gap:26px}
.hours{list-style:none;margin:0;padding:0;border-top:1px solid var(--line)}
.hours li{display:flex;justify-content:space-between;gap:16px;padding:13px 0;border-bottom:1px solid var(--line);font-size:15px}
.hours .day{color:var(--ink-2)}
.hours .h{text-align:right;font-variant-numeric:tabular-nums}
.hours li.today{font-weight:600}
.hours li.today .day::before{content:"";display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--rose-deep);margin-right:9px;vertical-align:2px}
.hours .closed{color:var(--ink-3)}
.badges{display:flex;flex-wrap:wrap;gap:8px;margin-top:22px}
.badge{
  font-size:13px;padding:7px 14px;border-radius:100px;
  background:var(--stone);color:var(--ink-2);
}
.reviews{display:flex;flex-wrap:wrap;gap:12px;margin-top:24px}
.rev{background:var(--paper);border:1px solid var(--line);border-radius:12px;padding:15px 18px;flex:1;min-width:130px}
.rev .score{font-family:var(--serif);font-size:26px;color:var(--rose-deep)}
.rev .src{font-size:12.5px;color:var(--ink-3);margin-top:2px}

/* ---------- footer ---------- */
footer{background:var(--ink);color:rgba(255,255,255,.62);padding:52px 0 34px;font-size:14.5px}
footer .flogo{height:44px;width:auto;opacity:.92;margin-bottom:22px}
.fgrid2{display:grid;gap:30px}
footer h4{color:#fff;font-family:var(--sans);font-size:12px;letter-spacing:.16em;text-transform:uppercase;margin:0 0 13px;font-weight:700}
footer a{color:rgba(255,255,255,.78);text-decoration:none}
footer a:hover{color:var(--rose)}
footer p{margin:0 0 7px}
.fbot{margin-top:38px;padding-top:22px;border-top:1px solid rgba(255,255,255,.13);font-size:13px;color:rgba(255,255,255,.42)}

/* ---------- responsive ---------- */
@media (min-width:600px){
  .strip .sep{display:inline;color:rgba(255,255,255,.28)}
  .trio{grid-template-columns:repeat(3,1fr);gap:16px}
  .events{grid-template-columns:repeat(2,1fr)}
  .cave{grid-template-columns:repeat(3,1fr)}
  .fgrid{grid-template-columns:1fr 1fr}
  .field--full{grid-column:1/-1}
  .fgrid2{grid-template-columns:repeat(3,1fr)}
}
@media (min-width:900px){
  .section{padding:88px 0}
  nav{display:flex}
  .hero{min-height:84vh}
  .menu-grid{grid-template-columns:1.55fr 1fr;align-items:start}
  .resa{grid-template-columns:1fr 1.15fr;align-items:start;gap:44px}
  .infos{grid-template-columns:1fr 1fr;gap:52px}
  .events{grid-template-columns:repeat(3,1fr)}
}
</style>
</head>
<body>

<header>
  <div class="wrap bar">
    <div class="brand"><img src="/assets/logo.jpg" alt="La Belle Époque — Cave à vin & Bar Gourmand"></div>
    <nav>
      <a href="#carte">La carte</a>
      <a href="#evenements">Événements</a>
      <a href="#cave">La cave</a>
      <a href="#infos">Nous trouver</a>
    </nav>
    <a href="#reserver" class="btn btn--ink btn--sm">Réserver</a>
  </div>
</header>

{{ content | safe }}

<footer>
  <div class="wrap">
    <img src="/assets/logo-dark.png" alt="La Belle Époque" class="flogo">
    <div class="fgrid2">
      <div>
        <h4>La maison</h4>
        <p>64 place du Marché<br>69590 Saint-Symphorien-sur-Coise</p>
        <p style="margin-top:12px"><a href="tel:0426554671">04 26 55 46 71</a></p>
        <p><a href="mailto:cavelabelleepoque@outlook.fr">cavelabelleepoque@outlook.fr</a></p>
      </div>
      <div>
        <h4>Horaires</h4>
        {% for j in horaires.jours %}
        <p>{{ j.jour }} · {% if j.ferme %}fermé{% else %}{% for c in j.creneaux %}{{ c.debut }}–{{ c.fin }}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}</p>
        {% endfor %}
      </div>
      <div>
        <h4>Suivez-nous</h4>
        <p><a href="https://www.facebook.com/p/Cave-La-Belle-%C3%89poque-100094164639847/">Facebook</a></p>
        <p><a href="#">Instagram</a></p>
        <p style="margin-top:12px"><a href="#reserver">Réserver une table</a></p>
      </div>
    </div>
    <div class="fbot">La Belle Époque — Cave à vin &amp; Bar Gourmand · L'abus d'alcool est dangereux pour la santé, à consommer avec modération.</div>
  </div>
</footer>

<script>
document.getElementById('form').addEventListener('submit', function(e){
  // Netlify Forms intercepte normalement la soumission côté serveur (voir
  // l'attribut data-netlify sur le <form>) ; ce script gère seulement le
  // retour visuel immédiat pendant que la requête part en arrière-plan.
  var form = this;
  setTimeout(function(){
    document.getElementById('ok').classList.add('show');
    form.style.display = 'none';
    document.getElementById('ok').scrollIntoView({behavior:'smooth', block:'center'});
  }, 50);
});

// Statut d'ouverture calculé en direct à partir de content/horaires.yml
// (injecté ci-dessous par le moteur de gabarits — une seule source pour
// le tableau affiché et pour ce calcul, plus de duplication à maintenir).
(function(){
  var HORAIRES = {{ horaires.jours | dump | safe }};
  function toMin(hhmm){ var p = hhmm.split(':'); return parseInt(p[0],10)*60 + parseInt(p[1],10); }
  function fmt(hhmm){ var p = hhmm.split(':'); var h = parseInt(p[0],10), m = parseInt(p[1],10); return h + 'h' + (m ? (m<10?'0':'')+m : ''); }

  var now = new Date(), d = now.getDay(), m = now.getHours()*60 + now.getMinutes();
  // HORAIRES est dans l'ordre Lundi(0)…Dimanche(6) ; Date.getDay() est Dimanche(0)…Samedi(6)
  var idx = (d === 0) ? 6 : d - 1;
  var today = HORAIRES[idx];
  var open = false, span = '';
  if (today && !today.ferme) {
    today.creneaux.forEach(function(c){
      if (m >= toMin(c.debut) && m < toMin(c.fin)) { open = true; }
    });
    span = today.creneaux.map(function(c){ return fmt(c.debut) + '–' + fmt(c.fin); }).join(' puis ');
  }
  var el = document.getElementById('status');
  if (open) {
    el.innerHTML = '<span class="dot"></span><b>Ouvert maintenant</b> <span>· ' + span + '</span>';
  } else if (today && !today.ferme) {
    el.innerHTML = '<span class="dot dot--off"></span><b>Fermé pour le moment</b> <span>· aujourd\'hui ' + span + '</span>';
  } else {
    el.innerHTML = '<span class="dot dot--off"></span><b>Fermé aujourd\'hui</b>';
  }
  var lis = document.querySelectorAll('.hours li');
  lis.forEach(function(li){ li.classList.remove('today'); });
  if (lis[idx]) lis[idx].classList.add('today');
})();
</script>
</body>
</html>
